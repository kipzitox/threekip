# Dependencies
node_modules/

# Expo / Metro
.expo/
dist/
dist-web/

# iOS native project (regenerated by EAS Build / expo prebuild)
ios/

# NOTE: android/ is committed on purpose. It ships the offline engine into
# android/app/src/main/assets/engine (loaded via file:///android_asset) because
# the withEngineAssets config plugin does not reliably run during EAS Build.

# Build artifacts
apk-check/
icon-tmp/
*.log
*.apk
*.txt
*.ps1
build/
.gradle/

# Keys / signing / secrets
# Kept broad on purpose: a real release keystore must never be committed, and
# the old rule only matched the literal path android/app/debug.keystore, so a
# differently named file would have been picked up silently.
*.jks
*.keystore
*.p8
*.p12
*.pem
*.key
*.mobileprovision
local.properties

# Real environment files. .env.example stays tracked as the template.
.env
.env.*
!.env.example

# OS
.DS_Store
