{
  "name": "threekip-mobile-web",
  "version": "1.0.0",
  "main": "server.ts",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "lint": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "android:prebuild": "expo prebuild --platform android && node scripts/copy-engine-assets.mjs",
    "copy-engine-assets": "node scripts/copy-engine-assets.mjs",
    "android:gradle": "cd android && ./gradlew assembleRelease",
    "android:apk-debug": "expo export:embed --platform android --entry-file node_modules/expo-router/entry.js --bundle-output android/app/src/main/assets/index.android.bundle --assets-dest android/app/src/main/assets --dev false && node scripts/copy-engine-assets.mjs && cd android && ./gradlew assembleDebug",
    "bundle-engine": "node scripts/bundle-engine.mjs"
  },
  "dependencies": {
    "@react-navigation/native": "^7.0.0",
    "@react-navigation/stack": "^7.0.0",
    "expo": "~52.0.0",
    "expo-asset": "~11.0.5",
    "expo-document-picker": "~13.0.3",
    "expo-file-system": "~18.0.12",
    "expo-router": "~4.0.0",
    "expo-sharing": "~13.0.1",
    "expo-status-bar": "~2.0.1",
    "express": "^4.19.2",
    "lucide-react-native": "^1.31.0",
    "react": "18.3.1",
    "react-native": "0.76.3",
    "react-native-gesture-handler": "~2.20.2",
    "react-native-reanimated": "~3.16.1",
    "react-native-safe-area-context": "4.12.0",
    "react-native-screens": "~4.4.0",
    "react-native-svg": "^15.8.0",
    "react-native-webview": "13.12.5",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@babel/core": "^7.25.0",
    "@types/express": "^4.17.21",
    "@types/react": "~18.3.12",
    "esbuild": "^0.28.2",
    "eslint": "^8.57.0",
    "eslint-config-expo": "~8.0.0",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3"
  },
  "private": true
}
