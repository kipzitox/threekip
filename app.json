{
  "expo": {
    "name": "ThreeKip",
    "slug": "threekip",
    "version": "1.0.0",
    
    "orientation": "default",
    "scheme": "threekip",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "icon": "./assets/engine/icon-512.png",
    "splash": {
      "image": "./assets/engine/icon-512.png",
      "backgroundColor": "#ffffff",
      "resizeMode": "contain"
    },
    "androidStatusBar": {
      "backgroundColor": "#ffffff",
      "translucent": false
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.threekip.app"
    },
    "android": {
      "package": "com.threekip.app",
      "softwareKeyboardLayoutMode": "pan",
      "permissions": [],
      "adaptiveIcon": {
        "foregroundImage": "./assets/engine/icon-512.png",
        "backgroundColor": "#ffffff"
      }
    },
    "plugins": [
      "expo-router",
      "./plugins/withEngineAssets.js"
    ],
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "2d5925be-53b9-4a9d-8cc4-bf3738b0e722"
      }
    }
  }
}